{
  "name": "扫一扫",
  "version": "1.0.32",
  "type": "scene",
  "category": "life",
  "description": "用 Rokid Glasses 自带 Barcode API 扫描二维码，智能识别文字、网址、Wi-Fi、名片、位置、日程和眼镜密语。",
  "permissions": [
    "camera",
    "network"
  ],
  "voiceCommands": [
    "扫一扫",
