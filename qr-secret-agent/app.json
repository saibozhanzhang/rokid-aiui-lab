    "开始扫描",
    "识别二维码",
    "重新扫描",
    "退出"
  ],
  "pages": [
    "pages/index/index"
  ],
  "window": {
    "backgroundColor": "#050807",
    "navigationBarBackgroundColor": "#050807",
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "扫一扫",
    "viewport": {
      "width": "device-width"
    }
  }
}
